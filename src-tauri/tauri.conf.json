{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web Test Scenario Creator",
  "version": "0.1.0",
  "identifier": "jp.renasan.webtestscenariocreator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Web Test Scenario Creator",
        "width": 1300,
        "height": 850
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}
